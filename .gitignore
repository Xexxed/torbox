# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Build & packaging artifacts
build/
dist/
*.egg-info/
*.egg
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Local sensitive configuration and credentials
token.txt
settings.json
*.token

# Account profiles: each holds a live saved session (access + refresh token)
profiles/
profiles.json

# Chrome profile used for the debug-mode sign-in browser
.chrome-debug/

# Local downloads target directory (Default)
downloads/

# IDE & Editor configurations
.idea/
.vscode/
.workbuddy/
.kilo/
.agents/
.workbuddy-ai/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS artifacts
Thumbs.db
[Dd]esktop.ini
ehthumbs.db
.DS_Store

# Logs & temp files
*.log
*.tmp
*.bak
scratch/
.scratch/

# Debug HTML dumps (may contain personal content names)
torbox_debug*.html
debug_*.html
*.html.dump

# Chrome CDP debug profile (throwaway, contains live session cookies)
.chrome-debug/

